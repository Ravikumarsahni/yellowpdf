# ============================================================================
# YellowPDF — environment variables template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database (Prisma) ---
# In the sandbox we use a local SQLite file. For production deploys
# (Vercel / Netlify / etc.) switch to Postgres — e.g. from Neon, Supabase,
# or your own Postgres instance. Then change `provider` in prisma/schema.prisma
# from "sqlite" to "postgresql" and run `bun run db:push`.
DATABASE_URL="file:./db/custom.db"
# Postgres example (uncomment for production):
# DATABASE_URL="postgresql://user:password@host:5432/yellowpdf?schema=public"

# --- z-ai-web-dev-sdk (powers the AI tools: Summarize / Translate / Chat /
# Key Points / OCR PDF). Without these, the AI tool endpoints will 500 but
# all 20+ non-AI PDF tools still work (they run 100% client-side). ---
# The SDK normally reads credentials from /etc/.z-ai-config in the sandbox.
# For production, set these (see skills/LLM/SKILL.md for the full list):
# ZAI_API_KEY=""
# ZAI_API_BASE=""

# --- NextAuth (only needed if you enable auth later — currently the site
# runs without sign-in). ---
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="https://your-domain.com"
